# Cloudflare R2設定（あなたのアカウント用）

# エンドポイント: アカウントID + .r2.cloudflarestorage.com
R2_ENDPOINT=https://ee3052802d9f583ae4332492cedbc291.r2.cloudflarestorage.com

# アクセスキー（APIトークン作成時に取得）
# まだ作成していない場合は、R2ダッシュボードで「APIトークンを作成」してください
R2_ACCESS_KEY_ID=ここにAccess_Key_IDを入力

# シークレットアクセスキー（APIトークン作成時に取得・一度しか表示されません）
R2_SECRET_ACCESS_KEY=ここにSecret_Access_Keyを入力

# バケット名
R2_BUCKET_NAME=youtube-downloads

# 公開URL（R2.devドメイン）
R2_PUBLIC_URL=https://pub-a814136a101142d19e7519d3c6694cc1.r2.dev
